#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""qq cp - 本機複製：目的地可以只打資料夾名稱，搜尋後選定再複製過去。"""

from __future__ import annotations

import locale
import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from qq_lib import (IS_WIN, MAX_RESULTS, QQError, ask_yes, collect, has_tty,
                    index_name, norm_path, run_ui, search_names)

HELP = """\
qq cp - 複製檔案／資料夾到指定資料夾（目的地可以只打資料夾名稱）

用法：
  qq cp [選項] <來源...> <目的地>

目的地：
  * 含路徑（有 / 、以 ~ 或 . 開頭）→ 直接當成路徑使用，跟一般 cp 一樣
  * 只有名稱（例如 document）→ 搜尋資料夾，列成選單讓你選，選定後才複製（不分大小寫）
    同名的排前面，接著是「名稱開頭相符」的（document 也會找到 Documents）
    目前所在位置底下若剛好有同名資料夾，會排在選單第一個；家目錄底下的排在其他位置前面
    沒有寫入權限的資料夾（系統目錄等）不會列出

選項：
  -f, --force   目的地已有同名檔案時直接覆蓋，不詢問
      --fresh   即時掃描硬碟找目的地（不使用索引資料庫）
  -h, --help    顯示本說明

範例：
  qq cp ~/mnt/test.txt document        複製到選定的 Documents 等資料夾
  qq cp a.txt b.txt projects           一次複製多個
  qq cp -f ~/mnt/photos Downloads      複製整個資料夾，已存在就覆蓋
  qq cp report.pdf ~/Desktop           目的地是路徑，不搜尋

說明：
  * 來源是資料夾時自動整個複製（保留檔案時間與權限）。
  * 選單：↑↓/jk 移動、Enter 選、q/Esc 取消。取消或失敗回傳非 0。
  * 沒有互動終端機時，只有找到唯一一個資料夾才會複製；有多個就停下，請改給完整路徑。
"""


class CpOptions:
    def __init__(self) -> None:
        self.force = False
        self.fresh = False
        self.help = False
        self.sources: list[str] = []
        self.dest = ""


def parse_args(argv: list[str]) -> CpOptions:
    o = CpOptions()
    pos: list[str] = []
    only_pos = False
    for a in argv:
        if only_pos:
            pos.append(a)
        elif a == "--":
            only_pos = True
        elif a in ("-f", "--force"):
            o.force = True
        elif a == "--fresh":
            o.fresh = True
        elif a in ("-h", "--help"):
            o.help = True
        elif a.startswith("-") and a != "-":
            raise QQError(f"未知的選項「{a}」（可用 -f、--fresh，詳見 qq cp --help）")
        else:
            pos.append(a)
    if o.help:
        return o
    if len(pos) < 2:
        raise QQError("用法：qq cp <來源...> <目的地>，例如：qq cp ~/mnt/test.txt document")
    o.sources, o.dest = pos[:-1], pos[-1]
    return o


def looks_like_path(s: str) -> bool:
    if s.startswith(("~", ".", "/")) or "/" in s:
        return True
    if IS_WIN and ("\\" in s or (len(s) >= 2 and s[1] == ":")):
        return True
    return False


def find_dest_dirs(query: str, fresh: bool) -> list[tuple[str, bool]]:
    """同名排前、開頭相符在後；各組內家目錄底下的優先。目前位置底下的同名資料夾放第一個。"""
    items = collect(search_names(query, fresh=fresh, prefix=True), "dir")
    # 沒有寫入權限的資料夾（系統目錄等）複製不進去，不列出來
    items = [it for it in items if os.access(it[0], os.W_OK | os.X_OK)]
    want = query.casefold()
    home = norm_path(os.path.expanduser("~")) + os.sep

    def rank(it):
        p = it[0]
        return (os.path.basename(p).casefold() != want, not p.startswith(home))

    out = sorted(items, key=rank)  # sorted 是穩定排序，組內維持原本「淺的在前」
    local = os.path.abspath(query)
    if os.path.isdir(local):
        local = norm_path(local)
        out = [(local, True)] + [it for it in out if it[0] != local]
    return out[:MAX_RESULTS]


def resolve_dest(o: CpOptions) -> str | None:
    """回傳目的地：資料夾（複製到裡面）或新路徑（單一來源改名複製）。取消回傳 None。"""
    d = o.dest
    if looks_like_path(d):
        p = os.path.abspath(os.path.expanduser(d))
        if os.path.isdir(p):
            return p
        if len(o.sources) == 1 and os.path.isdir(os.path.dirname(p) or "."):
            return p  # 跟 cp 一樣：目的地不存在 → 當成新名稱
        raise QQError(f"目的地資料夾不存在：{p}")

    try:
        items = find_dest_dirs(d, o.fresh)
    except QQError as exc:
        raise QQError(f"搜尋目的地失敗：{exc}")
    if not items:
        src = "即時掃描" if o.fresh else index_name()
        raise QQError(
            f"在{src}中找不到名稱為「{d}」（或以它開頭）、而且你有寫入權限的資料夾"
            + ("" if o.fresh else "；剛建立的資料夾可加 --fresh 即時掃描")
        )
    if not has_tty():
        if len(items) == 1:
            print(f"qq cp: 無互動終端機，唯一符合的資料夾：{items[0][0]}", file=sys.stderr)
            return items[0][0]
        lst = "\n".join("  " + p for p, _ in items[:10])
        more = f"\n  …共 {len(items)} 筆" if len(items) > 10 else ""
        raise QQError(f"無互動終端機，找到多個「{d}」資料夾，請改給完整路徑：\n{lst}{more}")

    n_exact = sum(1 for p, _ in items if os.path.basename(p).casefold() == d.casefold())
    title = f"qq cp  目的地「{d}」  同名 {n_exact} 筆、開頭相符 {len(items) - n_exact} 筆"
    names = "、".join(os.path.basename(s.rstrip("/\\")) or s for s in o.sources)
    if len(names) > 40:
        names = f"{len(o.sources)} 個項目"
    return run_ui(items, title, lambda p, _d: f"把 {names} 複製到 {p}")


def copy_one(src: str, dest: str, force: bool) -> str | None:
    """把 src 複製到 dest（dest 是資料夾就放進去）。回傳實際位置；略過回傳 None。"""
    src_abs = os.path.abspath(os.path.expanduser(src))
    if not os.path.lexists(src_abs):
        raise QQError(f"來源不存在：{src}")
    target = os.path.join(dest, os.path.basename(src_abs.rstrip("/\\"))) if os.path.isdir(dest) else dest
    if os.path.abspath(target) == src_abs:
        raise QQError(f"來源和目的地是同一個位置：{src_abs}")
    if os.path.isdir(src_abs) and not os.path.islink(src_abs):
        if os.path.abspath(dest).startswith(src_abs.rstrip(os.sep) + os.sep):
            raise QQError(f"不能把資料夾複製到它自己裡面：{src_abs} → {dest}")
        if os.path.exists(target):
            if not force and not ask_yes(f"{target} 已存在，要合併並覆蓋同名檔案嗎？"):
                print(f"qq cp: 略過 {src}", file=sys.stderr)
                return None
        shutil.copytree(src_abs, target, symlinks=True, dirs_exist_ok=True)
    else:
        if os.path.isdir(target):
            raise QQError(f"目的地已有同名資料夾，不能用檔案覆蓋：{target}")
        if os.path.lexists(target):
            if not force and not ask_yes(f"{target} 已存在，要覆蓋嗎？"):
                print(f"qq cp: 略過 {src}", file=sys.stderr)
                return None
        shutil.copy2(src_abs, target, follow_symlinks=False)
    return target


def main(argv: list[str]) -> int:
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    try:
        o = parse_args(argv)
    except QQError as exc:
        print(f"qq cp: {exc}", file=sys.stderr)
        return 2
    if o.help:
        print(HELP, end="")
        return 0

    missing = [s for s in o.sources if not os.path.lexists(os.path.expanduser(s))]
    if missing:
        print("qq cp: 來源不存在：" + "、".join(missing), file=sys.stderr)
        return 1
    try:
        dest = resolve_dest(o)
    except QQError as exc:
        print(f"qq cp: {exc}", file=sys.stderr)
        return 1
    if dest is None:
        print("qq cp: 已取消", file=sys.stderr)
        return 1

    rc = 0
    for s in o.sources:
        try:
            t = copy_one(s, dest, o.force)
        except (QQError, OSError, shutil.Error) as exc:
            print(f"qq cp: {exc}", file=sys.stderr)
            rc = 1
            continue
        if t:
            print(f"已複製 {s} → {t}", file=sys.stderr)
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
