#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""qq find - 依名稱搜尋，互動選擇後輸出完整路徑（由 qq.sh 負責 cd）。"""

from __future__ import annotations

import locale
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from qq_lib import run_name_command

HELP = """\
qq find - 依名稱快速搜尋資料夾與檔案

用法：
  qq find [選項] <名稱>

選項：
  -d, --dir     只搜尋資料夾
  -f, --file    只搜尋檔案
      --fresh   即時掃描硬碟（不使用索引資料庫）
  -h, --help    顯示本說明

說明：
  * 名稱採完全相符、不分大小寫（例如 mnt 只會找到名稱為 mnt 的項目）。
  * 預設同時搜尋資料夾與檔案，資料夾排在前面。
  * 預設使用索引（快）：Linux 用 plocate（沒裝則用 qq 自建索引）；
    macOS 合併 Spotlight 與內建 locate；Windows 用 qq 自建索引。
    自建索引每天自動更新，手動更新：qq-updatedb。
  * --fresh 改用 fd 即時掃描（較慢但一定是最新狀態），剛建的檔案請用它。
  * 選單操作：↑↓ 或 j/k 移動、PgUp/PgDn 翻頁、g/G 跳到頭／尾、
              Enter 選擇、q 或 Esc 取消。
  * 選到資料夾 → 切換到該資料夾；選到檔案 → 切換到該檔案所在資料夾。
  * 一律顯示選單讓你選擇（即使只有一筆結果）。若在無互動終端機的環境
    （例如腳本）執行，則直接選取第一筆。
  * 搭配其他指令：qq find -d mnt && ls
  * 人要留在原地、只拿完整路徑時，請用 qq pick。
"""


def main(argv: list[str]) -> int:
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    return run_name_command("find", argv, HELP)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
